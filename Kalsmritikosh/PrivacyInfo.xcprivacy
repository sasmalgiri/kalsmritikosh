<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Phase L — App Store privacy manifest. Required for all App
      Store submissions since 1 May 2024. Declares (a) the
      categories of personal data Kalsmritikosh accesses, (b) the
      required-reason APIs we call, and (c) whether we use any
      tracking domains.

      Private mode (the default) runs entirely on-device. The main
      app has no network entitlement; the embedded network helper
      (KalsmritikoshNetworkHelper) can reach only the three Online
      providers, and only when the person turns Online mode on and
      approves each send. See docs/DATA_FLOW_INVENTORY.md — the one
      source for every privacy statement. All on-disk data
      is owned by the user and lives in the app sandbox container
      (~/Library/Containers/<bundle-id>/Data) or in user-selected
      folders accessed via security-scoped bookmarks.
    -->

    <!-- We don't perform any tracking, in any sense Apple defines it. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains contacted. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      Personal-data categories the app collects (= sends off-device).
      OPEN DECISION (review L1, 2026-10-27): the publisher receives
      nothing, but Online mode, when the person turns it on, sends the
      question and, if allowed, document passages to the third-party
      AI provider they chose. Whether that must be declared here (and
      on the App Store label) is an owner/counsel decision recorded in
      docs/DATA_FLOW_INVENTORY.md §4. The array stays empty until that
      decision is made; it is NOT a finding that nothing leaves the Mac.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!--
      Required-reason API declarations (per
      https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api).

      File timestamp APIs — we read modification/creation dates of
      (a) files the person chose (folders granted through the open panel,
      kept as security-scoped bookmarks) to detect changes during
      incremental ingest — reason 3B52.1; and (b) files inside our own
      container (the ledger, caches) — reason C617.1.

      Disk space — before downloading an optional on-device model we
      check the volume has room for it
      (volumeAvailableCapacityForImportantUsage).
      Reason: 85F4.1 — Check there is enough space to write files.

      User defaults — we persist the app's own preferences (selected
      tab, feature flags) via UserDefaults.
      Reason: CA92.1 — Read/write the app's own defaults.
      The app also writes one switch ("Share and capture" on/off) to
      the app group shared with its own Share extension.
      Reason: 1C8F.1 — Defaults shared within the same app group.

      (System boot time is not declared: no boot-time API is called.
      LiveMetrics reads the process's own memory via
      mach_task_basic_info, which is not a required-reason API.)
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>3B52.1</string>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>85F4.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Phase L — App Store privacy manifest. Required for all App
      Store submissions since 1 May 2024. Declares (a) the
      categories of personal data Kalsmritikosh accesses, (b) the
      required-reason APIs we call, and (c) whether we use any
      tracking domains.

      Private mode (the default) runs entirely on-device. The main
      app has no network entitlement; the embedded network helper
      (KalsmritikoshNetworkHelper) can reach only the Online AI
      providers, the AI Included relay, five public-record sources and
      pages the person asks to capture — only in Online mode, each send
      approved first. See docs/DATA_FLOW_INVENTORY.md — the one
      source for every privacy statement. All on-disk data
      is owned by the user and lives in the app sandbox container
      (~/Library/Containers/<bundle-id>/Data) or in user-selected
      folders accessed via security-scoped bookmarks.
    -->

    <!-- We don't perform any tracking, in any sense Apple defines it. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains contacted. -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      Personal-data categories the app collects (= sends off-device and
      kept beyond the request). AGENT DETERMINATION 2026-11-01 (an agent
      review, not a legal approval — docs/DISTRIBUTION_PACK.md §1): with
      AI Included, approved questions, passages, page images and recordings
      go through the publisher's relay to Anthropic / Google under the
      publisher's account, and those providers may keep them up to 30 days
      → Other User Content and Audio Data, not linked (the relay forwards
      no identifier). The relay keeps the subscription's App Store
      transaction number with question counts → Purchase History, User ID
      and Product Interaction, linked. Passages from mail/chats → Emails or
      Text Messages; page images/videos → Photos or Videos (not linked).
      Widened 2026-11-02 after the agent legal review (S1).
      All for App Functionality only; never tracking. Nothing is sent in
      Private mode or without the person's approval of each send.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeAudioData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailsOrTextMessages</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!--
      Required-reason API declarations (per
      https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api).

      File timestamp APIs — we read modification/creation dates of
      (a) files the person chose (folders granted through the open panel,
      kept as security-scoped bookmarks) to detect changes during
      incremental ingest — reason 3B52.1; and (b) files inside our own
      container (the ledger, caches) — reason C617.1.

      Disk space — before downloading an optional on-device model we
      check the volume has room for it
      (volumeAvailableCapacityForImportantUsage).
      Reason: 85F4.1 — Check there is enough space to write files.

      User defaults — we persist the app's own preferences (selected
      tab, feature flags) via UserDefaults.
      Reason: CA92.1 — Read/write the app's own defaults.
      The app also writes one switch ("Share and capture" on/off) to
      the app group shared with its own Share extension.
      Reason: 1C8F.1 — Defaults shared within the same app group.

      (System boot time is not declared: no boot-time API is called.
      LiveMetrics reads the process's own memory via
      mach_task_basic_info, which is not a required-reason API.)
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>3B52.1</string>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>85F4.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

